# Copy to .env and fill in. NEVER commit .env.

# ---- SMTP (Gmail example; use an App Password, NOT your normal password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls        # starttls (port 587) or ssl (port 465)
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Sender / profile (used in templates) ----
SENDER_NAME=Your Name
SENDER_EMAIL=your.email@gmail.com
PHONE=+91 90000 00000
CITY=Pune
LINKEDIN_URL=https://linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-username

# ---- Files (relative paths resolve from where you run the command) ----
RESUME_PATH=./your_resume.pdf
# Public share link to the same resume (Google Drive: 'Anyone with the link'). Used in WhatsApp text.
RESUME_URL=https://drive.google.com/file/d/<FILE_ID>/view?usp=sharing
LEADS_EXCEL=./leads.xlsx               # default for --excel
STATE_DB=./data/outreach_state.sqlite3

# ---- Sending behaviour ----
DELAY_MIN_SECONDS=20
DELAY_MAX_SECONDS=45
MAX_PER_RUN=30

# ---- LinkedIn job-application workflow (apply-* commands) ----
AUTO_SEND_EMAILS=false                 # false = drafts need explicit approval before sending
ALLOW_MULTIPLE_JOBS_PER_RECIPIENT=false  # false = never e-mail the same address twice
MASTER_RESUME_JSON=./data/master_resume.json
RESUME_OUTPUT_DIR=./resumes
TRACKER_PATH=./data/applications_tracker.xlsx
MIN_JD_CHARS=40
SKIP_EMAIL_DOMAINS=gmail.com           # comma-separated, e.g. gmail.com,yahoo.com (set empty to disable)
FOLLOWUP_AFTER_DAYS=14
